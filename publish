#!/bin/bash
#
#       publish
#       (worktree version)
#

# Option and argument processing
while :; do
    case "$1" in
        [0-9]* )        challenge="$1";;
        json|-json )    PUBLISH_JSON=1;;
        * )             break;;
    esac
    shift
done

if [ ! "$challenge" ]; then
    last_challenge_dir="$( ls -d -r challenge-* | head -1 )"
    challenge="${last_challenge_dir##*-}"
fi

copy_files() {
    local source_branch="$1" source_dir="$2" target_branch="$3"
    shift 3
    local files=("$@")

    if [ -z "$source_branch" ] || [ -z "$source_dir" ] \
        || [ -z "$target_branch" ]
    then
        cat <<'EOF' >&2
usage: copy_files <source_branch> <source_dir> <target_branch> [file ...]
    <target_branch> must be a worktree of the same name at toplevel.
    With no files given, all files in <source_dir> are copied.
EOF
        return 2
    fi

    local pathspecs=()
    if [ "${#files[@]}" -eq 0 ]; then
        pathspecs=("$source_dir")
    else
        local f
        for f in "${files[@]}"; do
            pathspecs+=("$source_dir/$f")
        done
    fi

    (
        cd "$( git rev-parse --git-common-dir )"/.. || exit 1

        if [ ! -d "$target_branch" ]; then
            echo "error: worktree '$target_branch' not found" >&2
            exit 2
        fi

        cd "$target_branch" || exit 1

        local found_files
        set -x
        readarray -t found_files < <( git ls-tree -r --name-only \
            "$source_branch" -- "${pathspecs[@]}" )
        if [ "${#found_files[@]}" -eq 0 ]; then
            echo "error: no requested files found in '$source_branch'" >&2
            exit 1
        fi

        git checkout "$source_branch" -- "${found_files[@]}"
        set +x
        ls -l "$source_dir"
    )
}

publish_files() {
    local target_branch="$1" msg="$2" source_dir="$3"

    if [ -z "$target_branch" ] || [ -z "$source_dir" ]; then
        cat <<'EOF' >&2
usage: publish_files <target_branch> <msg> <source_dir>
    <target_branch> must be a worktree of the same name at toplevel.
EOF
        return 2
    fi

    (
        cd "$( git rev-parse --git-common-dir )"/.. || exit 1

        if [ ! -d "$target_branch" ]; then
            echo "error: worktree '$target_branch' not found" >&2
            exit 2
        fi

        cd "$target_branch" || exit 1

        local update=""
        [ -n "$( git ls-tree -d --name-only \
            "$target_branch" -- "$source_dir" )" ] && update=" - Update"

        git add "$source_dir"
        git commit -m "$msg$update" || true
        git push
    )
}

cd "$( git rev-parse --git-common-dir )"/.. || exit 1

if [ "$PUBLISH_JSON" ]; then
    # Publish 'challenge-NNN/examples/json' directory to 'json-examples' branch.
    source_dir="challenge-$challenge/examples/json"
    target_branch="json-examples"
    msg="Challenge $challenge .json example data and Perl solution skeletons"
    msg="Provide JSON test data for Challenge $challenge task examples"
    copy_files dev "$source_dir" json-examples ch-{1,2}.json
    publish_files json-examples "$msg" "$source_dir"
else
    # Publish challenge solution.
    source_dir="challenge-$challenge/matthias-muth"
    target_branch="muthm"
    files=( README.md blog.txt perl/ch-{1,2}.pl )
    false && echo "Activating testing section prepared for publishing"
    false && perl -i~ -g -n -E '
	s<^use lib .*?\n^use MultiTest.*?\n>
	    <use Test2::V0 qw( -no_srand );\n>ms;
	s<^run\( "(.*).*\z><>ms;
    ' "$dir"/perl/ch-[12].pl

    msg="Challenge $challenge Task 1 and 2 solutions in Perl by Matthias Muth"
    copy_files dev "$source_dir" muthm "${files[@]}"
    publish_files muthm "$msg" "$source_dir"
fi
